{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-cookbook.local/schemas/workspace-lease.schema.json",
  "title": "Workspace Lease v1",
  "type": "object",
  "required": ["lease_id", "workspace_id", "mode", "paths", "owner", "task_id", "acquired_at", "heartbeat_at", "expires_at", "fence_token", "state"],
  "properties": {
    "lease_id": {"type": "string", "format": "uuid"},
    "workspace_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mode": {"enum": ["read", "write"]},
    "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "owner": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "job_key": {"type": ["string", "null"]},
    "wip_key": {"type": ["string", "null"]},
    "acquired_at": {"type": "number"},
    "heartbeat_at": {"type": "number"},
    "expires_at": {"type": "number"},
    "fence_token": {"type": "integer", "minimum": 1},
    "state": {"enum": ["active", "released", "expired", "completed", "invalid"]}
  },
  "additionalProperties": false
}
