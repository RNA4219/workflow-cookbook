{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rna4219.github.io/workflow-cookbook/schemas/evaluation-identity-manifest.schema.json",
  "title": "EvaluationIdentityManifest",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "task_id",
    "owner",
    "purpose",
    "status",
    "freeze_date",
    "hypothesis",
    "action_delta",
    "negative_control",
    "identity",
    "evaluation",
    "external_mutations"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "profile": {
      "enum": [
        "game",
        "document_retrieval",
        "performance",
        "workflow"
      ]
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^eval:"
    },
    "task_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "owner": {
      "type": "string",
      "pattern": "\\S"
    },
    "purpose": {
      "enum": [
        "comparison",
        "experiment",
        "recovery",
        "promotion"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "frozen",
        "completed",
        "rejected"
      ]
    },
    "freeze_date": {
      "type": "string",
      "pattern": "\\S"
    },
    "hypothesis": {
      "type": "string",
      "pattern": "\\S"
    },
    "action_delta": {
      "type": "string",
      "pattern": "\\S"
    },
    "negative_control": {
      "type": "string",
      "pattern": "\\S"
    },
    "identity": {
      "type": "object",
      "required": [
        "legacy",
        "candidate",
        "runner"
      ],
      "properties": {
        "legacy": {
          "type": "object",
          "required": [
            "label",
            "source_path",
            "source_sha256",
            "input_sha256"
          ],
          "properties": {
            "label": {
              "type": "string",
              "pattern": "\\S"
            },
            "source_path": {
              "type": "string",
              "pattern": "\\S"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "input_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "candidate": {
          "type": "object",
          "required": [
            "label",
            "source_path",
            "source_sha256",
            "input_sha256"
          ],
          "properties": {
            "label": {
              "type": "string",
              "pattern": "\\S"
            },
            "source_path": {
              "type": "string",
              "pattern": "\\S"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "input_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "runner": {
          "type": "object",
          "required": [
            "id",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "evaluation": {
      "type": "object"
    },
    "external_mutations": {
      "type": "object",
      "required": [
        "registry_frozen",
        "submission_frozen"
      ],
      "properties": {
        "registry_frozen": {
          "const": true
        },
        "submission_frozen": {
          "const": true
        }
      }
    },
    "outcome": {
      "type": "object",
      "required": [
        "artifact_path",
        "artifact_sha256",
        "records"
      ],
      "properties": {
        "artifact_path": {
          "type": "string",
          "pattern": "\\S"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "records": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "profile": {
            "const": "game"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "required": [
          "profile"
        ],
        "properties": {
          "identity": {
            "properties": {
              "legacy": {
                "required": [
                  "source_revision"
                ],
                "properties": {
                  "source_revision": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              },
              "candidate": {
                "required": [
                  "source_revision"
                ],
                "properties": {
                  "source_revision": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              }
            }
          },
          "evaluation": {
            "type": "object",
            "required": [
              "dataset_id",
              "dataset_sha256",
              "primary_metric",
              "measurement_unit",
              "configuration",
              "model_version",
              "policy_version"
            ],
            "properties": {
              "dataset_id": {
                "type": "string",
                "pattern": "\\S"
              },
              "dataset_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "primary_metric": {
                "type": "string",
                "pattern": "\\S"
              },
              "measurement_unit": {
                "type": "string",
                "pattern": "\\S"
              },
              "configuration": {
                "type": "object"
              },
              "model_version": {
                "type": "string",
                "pattern": "\\S"
              },
              "policy_version": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          "outcome": {
            "required": [
              "metrics"
            ],
            "properties": {
              "metrics": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "schema_version": {
                "const": "1.0"
              }
            }
          },
          {
            "required": [
              "profile"
            ],
            "properties": {
              "profile": {
                "const": "game"
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "gate"
        ],
        "properties": {
          "gate": {
            "enum": [
              "G50",
              "G200",
              "G1000"
            ]
          },
          "identity": {
            "required": [
              "deck",
              "native_runtime"
            ],
            "properties": {
              "deck": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              },
              "native_runtime": {
                "type": "object",
                "required": [
                  "id",
                  "sha256",
                  "rng_control"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "rng_control": {
                    "enum": [
                      "controlled",
                      "uncontrolled"
                    ]
                  }
                }
              }
            }
          },
          "evaluation": {
            "type": "object",
            "required": [
              "opponent_set_id",
              "cohort_id",
              "target_deck",
              "opponents",
              "starts"
            ],
            "properties": {
              "opponent_set_id": {
                "type": "string",
                "pattern": "\\S"
              },
              "cohort_id": {
                "type": "string",
                "pattern": "\\S"
              },
              "target_deck": {
                "type": "string",
                "pattern": "\\S"
              },
              "opponents": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "starts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          },
          "outcome": {
            "type": "object",
            "required": [
              "total_games",
              "fallback_count",
              "illegal_action_count",
              "crash_count",
              "timeout_count"
            ],
            "properties": {
              "total_games": {
                "type": "integer",
                "minimum": 1
              },
              "fallback_count": {
                "const": 0,
                "type": "integer"
              },
              "illegal_action_count": {
                "const": 0,
                "type": "integer"
              },
              "crash_count": {
                "const": 0,
                "type": "integer"
              },
              "timeout_count": {
                "const": 0,
                "type": "integer"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "outcome": {
            "type": "object",
            "required": [
              "error_count",
              "crash_count",
              "timeout_count"
            ],
            "properties": {
              "error_count": {
                "const": 0,
                "type": "integer"
              },
              "crash_count": {
                "const": 0,
                "type": "integer"
              },
              "timeout_count": {
                "const": 0,
                "type": "integer"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "profile"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "profile": {
            "const": "game"
          }
        }
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "measurement_unit": {
                "const": "game"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "profile"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "profile": {
            "const": "document_retrieval"
          }
        }
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "measurement_unit": {
                "const": "query"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "profile"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "profile": {
            "const": "performance"
          }
        }
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "measurement_unit": {
                "const": "operation"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "profile"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "profile": {
            "const": "workflow"
          }
        }
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "measurement_unit": {
                "const": "task"
              }
            }
          }
        }
      }
    }
  ]
}
